<Window x:Class="DW3ArduinoEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DW3ArduinoEditor"
        xmlns:DW3ArduinoEditorConverters="clr-namespace:DW3ArduinoEditor.Converters"
        mc:Ignorable="d"
        Title="DW3 Arduino Editor"
        Height="730"
        Width="850"
        ResizeMode="NoResize">

   <Window.Resources>
      
      <DW3ArduinoEditorConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"
                                                            TrueValue="Visible"
                                                            FalseValue="Collapsed" />
      <DW3ArduinoEditorConverters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"
                                                            TrueValue="Collapsed"
                                                            FalseValue="Visible" />
      <DW3ArduinoEditorConverters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

      <Style TargetType="Button">
         <Setter Property="Padding" Value="10, 1" />
         <Setter Property="Margin" Value="2" />
         <Setter Property="Height" Value="26" />
      </Style>
      <Style TargetType="ComboBox">
         <Setter Property="Height" Value="26"/>
         <Setter Property="Margin" Value="2"/>
      </Style>
      <Style TargetType="CheckBox">
         <Setter Property="Margin" Value="2" />
      </Style>
      
   </Window.Resources>
   
   <Grid>
       
      <Grid.RowDefinitions>
         <RowDefinition Height="30"/>
         <RowDefinition />
      </Grid.RowDefinitions>

      <!-- Save/Write Operations -->
      <StackPanel Orientation="Horizontal"
                  Grid.Row="0">
         <Button Content="Save Editor Data"
                 Command="{Binding SaveGameDataCommand, Mode=OneTime}" />
         <Button Content="Write Game Data Source"
                 Command="{Binding WriteGameDataSourceCommand, Mode=OneTime}" />
      </StackPanel>

      <TabControl Grid.Row="1">

         <!-- Tile Maps Tab -->
         <TabItem Header="Tile Maps"
                  IsSelected="True">

            <StackPanel Orientation="Vertical">

               <!-- Tile Map Select/Rename/Add/Delete Operations -->
               <StackPanel Orientation="Horizontal">
                  <ComboBox ItemsSource="{Binding TileMaps}"
                            SelectedItem="{Binding SelectedTileMap}"
                            DisplayMemberPath="Name"
                            MinWidth="100"
                            VerticalContentAlignment="Center"/>
                  <Button Content="Rename"
                          Command="{Binding RenameSelectedTileMapCommand, Mode=OneTime}"/>
                  <Button Content="Add New Tile Map"
                          Command="{Binding AddNewTileMapCommand, Mode=OneTime}" />
                  <Button Content="Delete Selected Tile Map"
                          Command="{Binding DeleteSelectedTileMapCommand, Mode=OneTime}"/>
               </StackPanel>

               <!-- Tile Map Size and Texture Set -->
               <StackPanel Orientation="Horizontal">

                  <TextBlock Text="Tiles: "
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"/>
                  <TextBlock Text="{Binding SelectedTileMap.TilesX}"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="x"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedTileMap.TilesY}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                  <Button Content="Resize"
                          Command="{Binding ResizeSelectedTileMapCommand, Mode=OneTime}"/>

                  <TextBlock Text="Tile Texture Set: "
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedTileTextureSet.Name}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />
                  <Button Content="Change"
                          Command="{Binding ChangeTileTextureSetCommand, Mode=OneTime}"/>

               </StackPanel>

               <!-- Tile Map Editing Panels -->
               <StackPanel Orientation="Horizontal">

                  <!-- Tile Map Flags and Texture Set -->
                  <StackPanel Orientation="Vertical">

                     <CheckBox Content="Wraps Around"
                               Margin="10,10,0,0"
                               VerticalAlignment="Center"
                               IsChecked="{Binding SelectedTileMap.Wraps, Mode=TwoWay}"/>
                     <CheckBox Content="Affects Daylight"
                               Margin="10,5,0,0"
                               VerticalAlignment="Center"
                               IsChecked="{Binding SelectedTileMap.AffectsDaylight, Mode=TwoWay}"/>
                     <CheckBox Content="Is Underground"
                               Margin="10,5,0,0"
                               VerticalAlignment="Center"
                               IsChecked="{Binding SelectedTileMap.IsUnderground, Mode=TwoWay}"/>
                     <CheckBox Content="Has Encounters"
                               Margin="10,5,0,10"
                               VerticalAlignment="Center"
                               IsChecked="{Binding SelectedTileMap.HasEncounters, Mode=TwoWay}"/>

                     <!-- Tile Map Texture Selector -->
                     <ListBox x:Name="tileSelectionListView"
                              ItemsSource="{Binding SelectedTileTextureSet.TextureImages}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left"
                              Width="174"
                              Height="260" >
                        <ListBox.ItemsPanel>
                           <ItemsPanelTemplate>
                              <UniformGrid Columns="4" />
                           </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                           <DataTemplate>
                              <Image Source="{Binding Image}"
                                       Width="32"
                                       Height="32" />
                           </DataTemplate>
                        </ListBox.ItemTemplate>
                     </ListBox>
                     
                     <!-- Tile Edit Tool -->
                     <StackPanel Orientation="Horizontal"
                                 Margin="0,5,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="5,0,5,0"
                                   Text="Tool:" />
                        <ComboBox VerticalContentAlignment="Center"
                                  ItemsSource="{Binding TileEditToolValues}"
                                  ItemStringFormat=""
                                  SelectedItem="{Binding SelectedTileEditTool, Mode=TwoWay}">
                           <ComboBox.ItemTemplate>
                              <DataTemplate>
                                 <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                              </DataTemplate>
                           </ComboBox.ItemTemplate>
                        </ComboBox>
                     </StackPanel>

                     <!-- Tile Map Layers -->
                     <CheckBox x:Name="tileMapShowStaticSpritesCheckbox"
                               Content="Show static sprites"
                               Margin="10,10,0,0"
                               IsChecked="True" />

                  </StackPanel>

                  <!-- Tile Map Editor -->
                  <StackPanel Orientation="Vertical">
                     <local:TileMapPanel x:Name="TileMapPanel"
                                         Width="640"
                                         Height="560"
                                         Margin="10,10,0,0"
                                         SelectedTileMap="{Binding SelectedTileMap}"
                                         TileTexturePool="{Binding TileTexturePool}"
                                         StaticSpriteTexturePool="{Binding StaticSpriteTexturePool}"
                                         SelectedTileTextureSet="{Binding SelectedTileTextureSet}"
                                         SelectedStaticSpriteTextureSet="{Binding SelectedStaticSpriteTextureSet}"
                                         SelectedTileTextureIndex="{Binding SelectedIndex, ElementName=tileSelectionListView, Mode=TwoWay}"
                                         ShowStaticSprites="{Binding IsChecked, ElementName=tileMapShowStaticSpritesCheckbox, Mode=OneWay }"/>
                  </StackPanel>

               </StackPanel>

            </StackPanel>
            
         </TabItem> <!-- Tile Maps Tab -->

      </TabControl>

   </Grid>

</Window>
